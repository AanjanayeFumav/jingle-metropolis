# Copy to .env and fill in. NEVER commit .env.

# ---- Monad (hackathon demo: MONAD=true, or `npm run dev:monad`) ----
# Treasury / operator signer. Generate a fresh key; fund it with testnet MON at https://faucet.monad.xyz
MONAD_PRIVATE_KEY=0x...
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
MONAD_EXPLORER_URL=https://testnet.monadexplorer.com
# Optional: use your own merchant address instead of a generated one at deploy time
# MONAD_MERCHANT_ADDRESS=0x...

# ---- Privy (optional): merchant payout accounts as Privy server wallets. Without these a mock provider is used. ----
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=

# ---- Runtime ----
PORT=3100
# MOCK=true runs everything with no keys (default). MOCK=false = live Astra + Bridge (pre-existing, not part of the demo).

# ---- Astra (sandbox) — pre-existing live bank-debit leg, not needed for the demo ----
ASTRA_CLIENT_ID=
ASTRA_CLIENT_SECRET=
ASTRA_SANDBOX=true
ASTRA_REDIRECT_URI=http://localhost:3000/astra/callback
DEV_PUBLIC_IP=192.0.2.0
SMOKE_EMAIL=
SMOKE_PHONE=

# ---- Bridge (sandbox) — pre-existing live fiat-settlement leg, not needed for the demo ----
BRIDGE_API_KEY=sk-test-...
NGROK_DOMAIN=
