# Copy to .env and fill in. NEVER commit .env.
# ---- Astra (sandbox) — dashboard-sandbox.astra.finance ----
ASTRA_CLIENT_ID=
ASTRA_CLIENT_SECRET=
ASTRA_SANDBOX=true
ASTRA_REDIRECT_URI=http://localhost:3000/astra/callback

# ---- Bridge (sandbox) — dashboard.bridge.xyz, Sandbox toggle ON ----
BRIDGE_API_KEY=sk-test-...

# ---- Runtime ----
MOCK=false
# Public IP for Astra UserIntents (127.x.x.x auto-rejects; 192.0.2.0 is Astra's sanctioned test IP)
DEV_PUBLIC_IP=192.0.2.0

# ---- Smoke test identity (sandbox) ----
# Max 3 UserIntents per email — use plus-tags to stay unique, e.g. you+fumav1@gmail.com
SMOKE_EMAIL=
# US format +1XXXXXXXXXX. Use one of the 5 sandbox test phones from your Astra dashboard toggle.
SMOKE_PHONE=
